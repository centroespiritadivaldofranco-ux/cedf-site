// Schema do banco de dados — backend do site institucional (cedf-site)
// Fase 1: pedidos de oração/tratamento espiritual, enviados pelo site público.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PedidoOracao {
  id           String   @id @default(uuid())
  nomeCompleto String
  mensagem     String?
  atendido     Boolean  @default(false)
  criadoEm     DateTime @default(now())
}

// Guarda o token de acesso do Instagram Graph API (uma única linha).
// Token de longa duração dura 60 dias e é renovado automaticamente pelo
// backend antes de expirar — veja src/services/instagram.js.
model InstagramToken {
  id           String   @id @default("angelis")
  accessToken  String
  expiraEm     DateTime
  atualizadoEm DateTime @updatedAt
}
