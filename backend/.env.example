# Cole aqui a DATABASE_URL do seu banco PostgreSQL (Neon, Supabase, etc.)
# Pode ser o mesmo provedor usado no cedf-tesouraria — só crie um banco (ou schema) separado.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Porta local do servidor
PORT=3002

# Origem(ns) do site que podem chamar essa API, separadas por vírgula.
# Em produção, coloque o domínio real do site (ex: https://cedf.com.br)
FRONTEND_ORIGIN="http://localhost:5183"

# Token simples para proteger a listagem de pedidos (GET /api/oracoes) e a
# conexão do Instagram (POST /api/angelis/token).
# Troque por uma string longa e aleatória.
ADMIN_TOKEN="troque-por-um-token-longo-e-aleatorio"

# Dados do app criado no Meta for Developers (Instagram > API setup with
# Instagram login) — usados pra conectar e renovar o token do Ângelis sozinho.
# Veja backend/README.md, seção "Conectando o Instagram do Ângelis".
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Precisa ser EXATAMENTE a URL pública desse backend + /api/angelis/callback,
# e precisa estar cadastrada em "Business login settings" no painel do app.
INSTAGRAM_REDIRECT_URI="https://SEU-BACKEND.onrender.com/api/angelis/callback"

# Chave de API do Google Cloud Text-to-Speech, usada para ler as cartas
# psicografadas em voz alta (vozes Neural2, bem mais naturais que a voz padrão
# do navegador). Sem essa chave, o site volta a usar a voz do navegador como
# reserva. Veja backend/README.md, seção "Configurando a leitura em voz alta".
GOOGLE_TTS_API_KEY=""

# URL pública do backend do sistema da tesouraria (cedf-tesouraria), usada para
# buscar as cartas psicografadas cadastradas lá e exibi-las em /psicografias.
# Sem essa variável, a página de Psicografias fica sem conteúdo.
TESOURARIA_API_URL="https://SEU-BACKEND-TESOURARIA.onrender.com"

# Chave de API do Google Cloud (Console > APIs & Services > Credentials > Create
# Credentials > API key), com a "YouTube Data API v3" ativada no projeto. Não
# precisa de OAuth nem de login — é só pra ler dados públicos do canal. Veja
# backend/README.md, seção "Conectando o YouTube".
YOUTUBE_API_KEY=""

# ID do canal (não é o @handle). O canal @centroespiritadivaldofranco já vem
# como valor padrão no código; só troque se o canal mudar.
YOUTUBE_CHANNEL_ID="UCZ6iA0tn4mT3OegGDnfn2aw"
